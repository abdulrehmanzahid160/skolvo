# Safepay credentials are server-only. Use separate sandbox and production values.
SAFEPAY_ENV=sandbox
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Create recurring plans in the Safepay dashboard. Plan IDs stay server-side.
SAFEPAY_AGENT_STANDARD_PLAN_ID=
SAFEPAY_AGENT_STUDENT_PLAN_ID=
SAFEPAY_CAMPUSNOVA_BASIC_PLAN_ID=
SAFEPAY_CAMPUSNOVA_PRO_PLAN_ID=
SAFEPAY_SIGNALWATCH_510K_PLAN_ID=
SAFEPAY_SIGNALWATCH_MAUDE_PLAN_ID=
SAFEPAY_SIGNALWATCH_ENFORCEMENT_PLAN_ID=

# Existing website forms and durable webhook event storage
MONGODB_URI=
