# Public Paddle.js configuration (safe for browser bundles once issued)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Public Paddle price identifiers
NEXT_PUBLIC_PADDLE_AGENT_STANDARD_PRICE_ID=
NEXT_PUBLIC_PADDLE_AGENT_STUDENT_PRICE_ID=
NEXT_PUBLIC_PADDLE_CAMPUSNOVA_BASIC_PRICE_ID=
NEXT_PUBLIC_PADDLE_CAMPUSNOVA_PRO_PRICE_ID=
NEXT_PUBLIC_PADDLE_SIGNALWATCH_510K_PRICE_ID=
NEXT_PUBLIC_PADDLE_SIGNALWATCH_MAUDE_PRICE_ID=
NEXT_PUBLIC_PADDLE_SIGNALWATCH_ENFORCEMENT_PRICE_ID=

# Server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Existing website forms
MONGODB_URI=
